# Matches what eslint.config.js and every existing file already do. Editors read
# this; the linter does not, which is exactly why it is not redundant.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in markdown, and the existing docs use them.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[{*.json,*.jsonc}]
indent_size = 2
